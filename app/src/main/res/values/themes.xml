<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LibraryOfArts" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:windowBackground">@color/library_parchment</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.LibraryOfArts.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/library_parchment</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LibraryOfArts</item>
    </style>
</resources>
